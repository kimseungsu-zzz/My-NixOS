#!/usr/bin/env bash
# KDE Plasma's virtual desktop DBus API replaces upstream's bspwm-only workspace listener.
while :; do
  current=$(qdbus org.kde.KWin /VirtualDesktopManager current 2>/dev/null || true)
  desktops=$(qdbus --literal org.kde.KWin /VirtualDesktopManager desktops 2>/dev/null | grep -oE '[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}' || true)
  printf '(box :class "works" :orientation "h" :spacing 5 :space-evenly "false"'
  i=0
  while IFS= read -r desktop; do
    [ -n "$desktop" ] || continue
    i=$((i + 1))
    [ "$i" -le 6 ] || break
    icon=''
    [ "$desktop" = "$current" ] && icon=''
    printf ' (button :onclick "qdbus org.kde.KWin /VirtualDesktopManager setCurrent %s" :class "0" "%s")' "$desktop" "$icon"
  done <<< "$desktops"
  printf ')\n'
  sleep 2
done
